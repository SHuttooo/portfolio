---
const { g, start = 0, end, indices } = Astro.props;
const fr: string[] = g.skillsFr ?? g.skills ?? [];
const en: string[] = g.skillsEn ?? g.skills ?? [];
const levels: number[] = g.levels ?? [];
const chosen: number[] = indices ?? Array.from(fr.keys()).slice(start,end);
---
<div class="sk-tags">
  {chosen.map((index)=>{
    const name=fr[index];
    return <span class="sk-tag"><span class="sk-tag-name"><span class="fr">{name}</span><span class="en">{en[index]??name}</span></span>{!g.wish&&<><span class="sk-dots" aria-hidden="true">{[1,2,3].map(d=><span class:list={['sk-dot',{on:d<=(levels[index]||0)}]} style={d<=(levels[index]||0)?`background:${g.color}`:undefined}></span>)}</span><span class="sr-only"><span class="fr">Niveau {levels[index]||0} sur 3</span><span class="en">Level {levels[index]||0} of 3</span></span></>}</span>;
  })}
</div>

---
import { CATS, SOURCES } from '../lib/config';
import { media } from '../lib/render';
// Couleurs de bord extraites des images par scripts/media-colors.mjs : elles
// peignent les bandes laissées par object-fit:contain, pour que l'image se
// fonde dans sa carte au lieu de flotter sur un fond arbitraire.
import MEDIA_COLORS from '../data/media-colors.json';
import CARD_PRESENTATION from '../data/project-cards.json';

interface Props { p: any; index?: number; fillRow?: boolean; }
const { p, index = 0, fillRow = false } = Astro.props;

const c = CATS[p.category] ?? CATS.other;
const s = p.source ? SOURCES[p.source] : null;

const imgBlock = (p.blocks ?? []).find((b: any) => b.type === 'image');
const thumb = p.thumb || (imgBlock && imgBlock.src) || null;
const thumbBg = thumb ? (MEDIA_COLORS as Record<string, string>)[thumb] : null;

const repo = p.link && String(p.link).includes('github.com') ? p.link : null;
const dataStack = (p.stack ?? []).join('|');
const presentation = (CARD_PRESENTATION as Record<string, any>)[p.id] ?? {};
const technologies = (presentation.technologies ?? [0, 1, 2]).map((i: number) => p.stack?.[i]).filter(Boolean).slice(0, 3);
const statusFr = presentation.statusFr ?? (p.concept ? 'Concept · à venir' : p.wip ? 'En cours' : 'Réalisé');
const statusEn = presentation.statusEn ?? (p.concept ? 'Concept · upcoming' : p.wip ? 'In progress' : 'Completed');
---

<article class:list={['proj-card',`featured-layout-${p.featuredLayout ?? 'standard'}`,{'featured':p.featured,'text-card':!thumb,'featured-fill-row':fillRow}]} data-href={`/projets/${p.id}/`} data-stack={dataStack} data-date={p.date??''} data-featured={p.featured?'1':'0'}>
 {thumb&&<div class="proj-thumb preview" style={thumbBg?`background:${thumbBg}`:undefined}><img class="proj-thumb-img" src={media(thumb)} alt={p.titleFr} loading="lazy" decoding="async"/>{p.preview&&<><video data-src={media(p.preview)} poster={media(thumb)} muted loop playsinline preload="none" aria-hidden="true"></video><button class="preview-toggle" type="button" aria-label="Voir la vidéo" aria-pressed="false" data-stop title="Voir la vidéo">▶</button></>}</div>}
 <div class="proj-body">
  <div class="proj-card-top">{s&&<span class="source-badge"><span class="fr">{s.fr}</span><span class="en">{s.en}</span></span>}{p.featured&&<span class="feat-badge"><span class="fr">À la une</span><span class="en">Featured</span></span>}</div>
  <h3 class="proj-title"><a href={`/projets/${p.id}/`}><span class="fr">{p.titleFr}</span><span class="en">{p.titleEn}</span></a></h3>
  <p class="proj-desc"><span class="fr">{p.summaryFr||p.descFr}</span><span class="en">{p.summaryEn||p.descEn}</span></p>
  <details class="project-description" data-stop>
    <summary><span class="description-open"><span class="fr">Description complète</span><span class="en">Full description</span> +</span><span class="description-close"><span class="fr">Réduire</span><span class="en">Show less</span> −</span></summary>
    <p><span class="fr">{p.descFr}</span><span class="en">{p.descEn}</span></p>
  </details>
  <div class="project-card-meta">
    <ul class="project-key-tech" aria-label="Technologies">{technologies.map((technology: string)=><li>{technology}</li>)}</ul>
    <span class:list={['project-status', {'is-ongoing':p.wip || p.concept || ['arcade','avion-rc','sites-vitrines'].includes(p.id)}]}><span class="fr">{statusFr}</span><span class="en">{statusEn}</span></span>
  </div>
  <div class="proj-foot"><a class="proj-more" href={`/projets/${p.id}/`}><span class="fr">Voir le projet</span><span class="en">View project</span> →</a>{repo&&<a class="proj-gh" href={repo} target="_blank" rel="noopener" data-stop>Code ↗</a>}</div>
 </div>
</article>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Blocks from '../../components/blocks/Blocks.astro';
import ProjectStory from '../../components/ProjectStory.astro';
import { media } from '../../lib/render';
import ProjectLink from '../../components/ProjectLink.astro';
import { CATS } from '../../lib/config';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((e) => ({ params: { id: e.data.id }, props: { p: e.data } }));
}

const { p } = Astro.props;
const c = CATS[p.category] ?? CATS.other;
const all=(await getCollection('projects')).map(e=>e.data).sort((a,b)=>(b.date??'').localeCompare(a.date??''));
const position=all.findIndex(x=>x.id===p.id);const previous=all[(position-1+all.length)%all.length];const next=all[(position+1)%all.length];

// Bloc "Crédits" en dernier : on l'affiche APRÈS le lien (comme l'ancien site).
const blocks = p.blocks ?? [];
const last = blocks[blocks.length - 1];
const isCredits = last && last.type === 'text' && (last.contentFr ?? last.content ?? '').includes('Cr');
const mainBlocks = isCredits ? blocks.slice(0, -1) : blocks;
const creditBlock = isCredits ? [last] : [];
const chapterBlocks=mainBlocks.filter((block:any)=>block.type==='chapters');
const hasHero=Boolean(p.preview||p.thumb);
const headings=mainBlocks.flatMap((block:any,index:number)=>{
  const fr=(block.contentFr??block.content??'').match(/^## ([^\n]+)/)?.[1];
  const en=(block.contentEn??block.content??'').match(/^## ([^\n]+)/)?.[1];
  return fr?[{index,fr,en:en??fr,chapter:block.chapter}]:[];
});
---
<Base title={`${p.titleFr} — Matthieu Vinet`} titleEn={`${p.titleEn} — Matthieu Vinet`} description={p.descFr} descriptionEn={p.descEn} path={`/projets/${p.id}/`}>
  <Nav />
  <main id="view-project" style="display:block">
    <div class="proj-detail">
      <a class="back-btn" href="/#projects">
        &larr; <span class="fr">Retour aux projets</span><span class="en">Back to projects</span>
      </a>
      <div id="detail-content">
       <header class:list={['project-header',{'has-media':hasHero}]}>
        <div class="project-header-copy">
        <div class="detail-tag" style={`color:${c.color};background:${c.bg};border-color:${c.color}30`}>
          <span class="fr">{c.fr}</span><span class="en">{c.en}</span>
        </div>
        <h1 class="detail-title"><span class="fr">{p.titleFr}</span><span class="en">{p.titleEn}</span></h1>
        <div class="detail-stack">
          {(p.stack ?? []).map((t: string) => <span class="sb" style="font-size:.78rem;padding:.25rem .7rem">{t}</span>)}
        </div>

        <p class="detail-intro"><span class="fr">{p.descFr}</span><span class="en">{p.descEn}</span></p>
        </div>
        {hasHero&&<figure class="project-header-media">
          {p.preview?<Blocks blocks={[{type:'video',src:p.preview}]}/>:<img src={media(p.thumb)} alt={p.titleFr} decoding="async"/>}
          <figcaption><span class="fr">{p.preview?'Démonstration du projet':'Aperçu du projet'}</span><span class="en">{p.preview?'Project demonstration':'Project overview'}</span></figcaption>
        </figure>}
       </header>
        <Blocks blocks={chapterBlocks}/>
        {headings.length>2&&<details class="project-toc">
          <summary><span class="fr">Parcourir les sections</span><span class="en">Browse sections</span> +</summary>
          <nav aria-label="Sections du projet">{headings.map(heading=><a href={`#project-section-${heading.index}`} class:list={[{'chap-block':heading.chapter,'on':heading.chapter===1}]} data-chap={heading.chapter?String(heading.chapter):undefined}><span class="fr">{heading.fr}</span><span class="en">{heading.en}</span></a>)}</nav>
        </details>}
        <div class="detail-summary">{[['role','Ma contribution','My contribution'],['result','Résultat observé','Observed result'],['limit','Limites','Limits']].map(([field,fr,en])=>p[field+'Fr']&&<section><h2><span class="fr">{fr}</span><span class="en">{en}</span></h2><p><span class="fr">{p[field+'Fr']}</span><span class="en">{p[field+'En']}</span></p></section>)}</div>
        <ProjectStory blocks={mainBlocks} projectId={p.id}/>
        {p.link && <ProjectLink url={p.link} />}
        <Blocks blocks={creditBlock} />
      </div>
      <nav class="project-pagination" aria-label="Navigation entre projets"><a href={`/projets/${previous.id}/`}><span class="pagination-label"><span class="fr">← Projet précédent</span><span class="en">← Previous project</span></span><span class="fr">{previous.titleFr}</span><span class="en">{previous.titleEn}</span></a><a href={`/projets/${next.id}/`}><span class="pagination-label"><span class="fr">Projet suivant →</span><span class="en">Next project →</span></span><span class="fr">{next.titleFr}</span><span class="en">{next.titleEn}</span></a></nav>
    </div>
  </main>
</Base>

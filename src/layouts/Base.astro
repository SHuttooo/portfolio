---
import '../styles/global.css';

interface Props {
  title?: string;
  titleEn?: string;
  descriptionEn?: string;
  description?: string;
  path?: string; // chemin canonique, ex "/" ou "/projets/serre/"
}
const {
  title = 'Matthieu Vinet — Étudiant Ingénieur en Robotique | ROS2 · Navigation autonome',
  description = "Étudiant ingénieur en Robotique à Polytech Sorbonne (5ème et dernière année), de retour d'un stage R&D chez Botshare.ai (Berlin). Commande, logiciel embarqué et essais de robots réels. Premières expérimentations de robot learning avec assistance IA. Recherche stage 6 mois — Paris, mi-février 2027.",
  path = '/',
} = Astro.props;
const titleEn=Astro.props.titleEn||'Matthieu Vinet — Robotics engineering student';
const descriptionEn=Astro.props.descriptionEn||'Final-year robotics student at Polytech Sorbonne. Control, embedded software and real robot testing. Seeking a six-month internship in Paris from mid-February 2027.';
const canonical = new URL(path, 'https://matthieu-vinet.fr').href;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title data-fr={title} data-en={titleEn}>{title}</title>
  <meta name="description" content={description} data-fr={description} data-en={descriptionEn} />
  <meta name="author" content="Matthieu Vinet" />
  <meta name="theme-color" content="#1a2fff" />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} data-fr={title} data-en={titleEn} />
  <meta property="og:description" content={description} data-fr={description} data-en={descriptionEn} />
  <meta property="og:image" content="https://matthieu-vinet.fr/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} data-fr={title} data-en={titleEn} />
  <meta name="twitter:description" content={description} data-fr={description} data-en={descriptionEn} />
  <meta name="twitter:image" content="https://matthieu-vinet.fr/og-image.jpg" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Applique le thème avant le rendu pour éviter le flash clair/sombre -->
  <script is:inline>
    (function () {
      var styles=['atelier','studio','editorial','solaire'];
      var visual;try{visual=localStorage.getItem('portfolio-visual-style');}catch{}
      if(styles.indexOf(visual)===-1){
        visual=styles[Math.floor(Math.random()*styles.length)];
        try{localStorage.setItem('portfolio-visual-style',visual);}catch{}
      }
      document.documentElement.dataset.visualStyle=visual;
      document.documentElement.dataset.initialStyle=visual;
      var s;try{s = localStorage.getItem('theme');}catch{}
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (s === 'dark' || (!s && d)) document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="lang-fr">
  <a class="skip-link" href={path==='/'?'#view-home':'#view-project'}><span class="fr">Aller au contenu</span><span class="en">Skip to content</span></a>
  <slot />

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image agrandie / Enlarged image" onclick="closeLightbox()">
    <button type="button" class="lb-close" aria-label="Fermer / Close">&#x2715;</button>
    <img id="lb-img" src="" alt="" />
  </div>

  <script src="/app.js" defer></script>
</body>
</html>
